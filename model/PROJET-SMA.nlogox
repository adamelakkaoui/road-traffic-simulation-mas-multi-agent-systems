<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.2" snapToGrid="false">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BREEDS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

breed [cars car]
breed [bikes bike]
breed [police-officers police]
breed [pedestrians pedestrian]
breed [lights light]
breed [bus-stops bus-stop]
breed [buses bus]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VARIABLES GLOBALES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  ;; Statistiques principales
  accidents
  violations
  tickets-issued
  average-waiting-time
  total-distance
  total-travel-time

  ;; Métriques avancées
  congestion-level
  average-speed
  traffic-flow
  accident-hotspots

  ;; Environnement
  current-hour
  weather-condition
  rush-hour?

  ;; Visualisation
  show-heatmap?
  show-paths?
  heatmap-data
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VARIABLES DES PATCHES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

patches-own [
  road?
  speed-zone
  crosswalk?
  intersection?
  zone-type
  traffic-density
  accident-count
  congestion-score
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VARIABLES DES VÉHICULES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

cars-own [
  speed
  violated?
  max-speed
  waiting-time
  travel-time
  destination
  path-to-destination
  driver-personality
  fuel-efficiency
  has-gps?
  total-distance-traveled
]

bikes-own [
  speed
  violated?
  max-speed
  waiting-time
  travel-time
  destination
  driver-personality
  total-distance-traveled
  has-gps?                    ;; AJOUTÉ
  path-to-destination         ;; AJOUTÉ
  fuel-efficiency             ;; AJOUTÉ (optionnel)
]

buses-own [
  speed
  max-speed
  current-stop
  next-stop
  passengers
  waiting-time
  route
]

police-officers-own [
  target
  patrol-mode?
  tickets-given
  patrol-route
  efficiency-score
]

lights-own [
  state
  light-timer
  green-duration
  axis
  cycle-id
  traffic-detected
  adaptive-mode?
]

pedestrians-own [
  destination
  waiting-at-crosswalk?
  patience
]

bus-stops-own [
  stop-id
  waiting-passengers
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP PRINCIPAL
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all

  ;; Initialisation des variables globales
  set accidents 0
  set violations 0
  set tickets-issued 0
  set average-waiting-time 0
  set total-distance 0
  set total-travel-time 0
  set congestion-level 0
  set average-speed 0
  set traffic-flow 0

  ;; Environnement
  set current-hour 8
  set weather-condition "clear"
  set rush-hour? false

  ;; Visualisation
  set show-heatmap? false
  set show-paths? false
  set heatmap-data []

  ;; Construction de la ville
  setup-city-zones
  setup-roads
  setup-lights
  setup-bus-stops

  ;; Création des agents
  setup-vehicles
  setup-police
  setup-pedestrians
  setup-buses

  reset-ticks
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP VILLE AVEC ZONES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-city-zones
  ask patches [
    set crosswalk? false
    set intersection? false
    set traffic-density 0
    set accident-count 0
    set congestion-score 0

    let x-zone floor (pxcor / 10)
    let y-zone floor (pycor / 10)

    if (abs x-zone > 1 and abs y-zone > 1) [
      set zone-type "residential"
    ]
    if (abs x-zone <= 1 and abs y-zone <= 1) [
      set zone-type "commercial"
    ]
    if (zone-type != "residential" and zone-type != "commercial") [
  set zone-type "industrial"
]
  ]
end

to setup-roads
  ask patches [
    ifelse
      (abs pxcor mod 5 <= 1) or
      (abs pycor mod 5 <= 1)
    [
      set road? true
      set pcolor gray - 1

      if zone-type = "residential" [ set speed-zone 1.0 ]
      if zone-type = "commercial" [ set speed-zone 1.5 ]
      if zone-type = "industrial" [ set speed-zone 2.0 ]
    ]
    [
      set road? false
      if zone-type = "residential" [ set pcolor green + 2 ]
      if zone-type = "commercial" [ set pcolor gray + 2 ]
      if zone-type = "industrial" [ set pcolor brown + 2 ]
    ]
  ]

  ask patches with [
    road? and
    abs pxcor mod 5 = 0 and
    abs pycor mod 5 = 0
  ] [
    set crosswalk? true
    set intersection? true
    set pcolor white
  ]

  ask patches with [road? and not intersection?] [
    if any? neighbors with [intersection?] [
      set pcolor gray - 0.5
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; FEUX INTELLIGENTS ADAPTATIFS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-lights
  ask patches with [intersection?] [
    sprout-lights 2 [
      set shape "circle"
      set size 1.2
      set light-timer 0
      set green-duration 30
      set adaptive-mode? true
      set traffic-detected 0

      ifelse who mod 2 = 0 [
        set axis "vertical"
        setxy xcor + 0.5 ycor + 0.5
        set state "green"
        set color green
        set cycle-id 0
      ] [
        set axis "horizontal"
        setxy xcor - 0.5 ycor - 0.5
        set state "red"
        set color red
        set cycle-id 1
      ]
    ]
  ]
end

to update-lights-intelligent
  ask lights [
    let my-axis axis
    set traffic-detected count turtles with [
      (breed = cars or breed = bikes or breed = buses) and
      distance myself < 5 and
      ((my-axis = "vertical" and (heading = 0 or heading = 180)) or
       (my-axis = "horizontal" and (heading = 90 or heading = 270)))
    ]

    let base-duration 30
    if rush-hour? [ set base-duration 40 ]

    if adaptive-mode? [
      if traffic-detected >= 15 [ set green-duration base-duration + 30 ]
      if traffic-detected >= 8 and traffic-detected < 15 [ set green-duration base-duration + 15 ]
      if traffic-detected >= 3 and traffic-detected < 8 [ set green-duration base-duration ]
      if traffic-detected < 3 [ set green-duration base-duration - 10 ]
    ]

    set light-timer light-timer + 1

    if state = "green" and light-timer >= green-duration [
      set state "yellow"
      set color yellow
      set light-timer 0
    ]

    if state = "yellow" and light-timer >= 8 [
      set state "red"
      set color red
      set light-timer 0

      ask other lights-here [
        if state = "red" and light-timer > 5 [
          set state "green"
          set color green
          set light-timer 0
        ]
      ]
    ]

    if state = "red" and light-timer >= 50 [
      if not any? other lights-here with [state = "green" or state = "yellow"] [
        set state "green"
        set color green
        set light-timer 0
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ARRÊTS DE BUS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-bus-stops
  ;; Créer d'abord tous les arrêts avec stop-id = 0
  ask patches with [
    road? and
    (pxcor mod 10 = 0) and
    (pycor mod 10 = 0)
  ] [
    sprout-bus-stops 1 [
      set shape "house"
      set color brown
      set size 1.5
      set stop-id 0
      set waiting-passengers random 5
    ]
  ]

  ;; Numéroter APRÈS création, depuis l'observer (pas dans ask)
  let counter 0
  foreach sort-by [[a b] -> [who] of a < [who] of b] bus-stops [ s ->
    ask s [ set stop-id counter ]
    set counter counter + 1
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP VÉHICULES AVEC PERSONNALITÉS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-vehicles
  create-cars number-of-cars [
    set shape "car"
    set driver-personality one-of ["aggressive" "normal" "normal" "normal" "cautious"]

    if driver-personality = "aggressive" [ set color red ]
    if driver-personality = "normal" [ set color blue + random-float 2 - 1 ]
    if driver-personality = "cautious" [ set color green ]

    move-to one-of patches with [road? and not intersection?]

    if driver-personality = "aggressive" [ set max-speed 1.8 + random-float 0.4 ]
    if driver-personality = "normal" [ set max-speed 1.2 + random-float 0.3 ]
    if driver-personality = "cautious" [ set max-speed 0.8 + random-float 0.2 ]

    set speed max-speed
    set violated? false
    set waiting-time 0
    set travel-time 0
    set has-gps? (random 100 < gps-adoption-rate)
    set fuel-efficiency 0.8 + random-float 0.4
    set total-distance-traveled 0

    set destination one-of patches with [road? and distance myself > 20]
    set path-to-destination []
  ]

create-bikes number-of-bikes [
  set shape "motorcycle"
  set color orange + random-float 2 - 1
  set driver-personality one-of ["aggressive" "normal" "cautious"]

  ;; Placement amélioré
  let valid-patch one-of patches with [
    road? and
    not intersection? and
    (abs pxcor mod 5 = 0 or abs pycor mod 5 = 0)
  ]
  if valid-patch != nobody [ move-to valid-patch ]

  ;; Vitesse et propriétés
  if driver-personality = "aggressive" [ set max-speed 2.0 + random-float 0.5 ]
  if driver-personality = "normal" [ set max-speed 1.8 + random-float 0.3 ]
  if driver-personality = "cautious" [ set max-speed 1.5 + random-float 0.2 ]

  set speed max-speed
  set violated? false
  set waiting-time 0
  set travel-time 0
  set total-distance-traveled 0
  set has-gps? (random 100 < gps-adoption-rate)
  set path-to-destination []
  set fuel-efficiency 0.8 + random-float 0.4
  set destination one-of patches with [road? and distance myself > 15]
]

  choose-lane-direction
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP POLICE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-police
  create-police-officers number-of-police [
    set shape "person police"
    set color red
    move-to one-of patches with [road?]
    set patrol-mode? true
    set tickets-given 0
    set target nobody
    set efficiency-score 0
    set patrol-route []
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP PIÉTONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-pedestrians
  create-pedestrians number-of-pedestrians [
    set shape "person"
    set color white
    move-to one-of patches with [not road?]
    set destination one-of patches with [not road? and distance myself > 10]
    set waiting-at-crosswalk? false
    set patience 50 + random 50
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP BUS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-buses
  create-buses number-of-buses [
    set shape "bus"
    set color yellow
    set size 2

    ;;  Placer le bus sur une intersection (là où sont les arrêts)
    move-to one-of patches with [road? and intersection?]

    set max-speed 1.2
    set speed max-speed
    set passengers 0
    set waiting-time 0

    ;; Trier les arrêts par stop-id pour avoir un circuit ordonné
    let bus-stop-list sort-by [[s1 s2] ->
      [stop-id] of s1 < [stop-id] of s2
    ] bus-stops

    set route bus-stop-list
    set current-stop 0

    if length route > 0 [
      set next-stop item current-stop route
      ;;  Orienter le bus vers le premier arrêt dès le départ
      set heading bus-best-direction next-stop
    ]
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DIRECTIONS ET NAVIGATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to choose-lane-direction
  ask turtles with [breed = cars or breed = bikes] [

    ;; Sur voie verticale seulement (pas intersection)
    if abs pxcor mod 5 = 0 and abs pycor mod 5 != 0 [
      ifelse pxcor >= 0 [ set heading 180 ] [ set heading 0 ]
    ]

    ;; Sur voie horizontale seulement (pas intersection)
    if abs pycor mod 5 = 0 and abs pxcor mod 5 != 0 [
      ifelse pycor >= 0 [ set heading 270 ] [ set heading 90 ]
    ]

    ;; À une intersection : choisir direction verticale par défaut
    if abs pxcor mod 5 = 0 and abs pycor mod 5 = 0 [
      ifelse pxcor >= 0 [ set heading 180 ] [ set heading 0 ]
    ]

    ;; Hors route : trouver la route la plus proche et s'y placer
    if abs pxcor mod 5 != 0 and abs pycor mod 5 != 0 [
      let nearest-road min-one-of patches with [
        road? and not intersection?
      ] in-radius 5 [distance myself]

      ifelse nearest-road != nobody [
        move-to nearest-road
        ;; Redéfinir la direction après déplacement
        if abs pxcor mod 5 = 0 [
          ifelse pxcor >= 0 [ set heading 180 ] [ set heading 0 ]
        ]
        if abs pycor mod 5 = 0 [
          ifelse pycor >= 0 [ set heading 270 ] [ set heading 90 ]
        ]
      ] [
        ;; Dernier recours : route aléatoire
        move-to one-of patches with [road? and not intersection?]
        set heading find-road-direction
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; IA : PATHFINDING SIMPLIFIÉ
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to navigate-to-destination
  ask turtles with [breed = cars or breed = bikes] [
    if destination != nobody and has-gps? [

      if distance destination > 2 [
        if [intersection?] of patch-here [
          ;; CORRECTION : utiliser seulement des directions qui restent sur route
          set heading road-heading-towards-dest destination
        ]
      ]

      if distance destination < 2 [
        set destination one-of patches with [road? and distance myself > 20]
        set travel-time 0
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; COMPORTEMENTS DES VÉHICULES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to obey-lights-smart
  ask turtles with [breed = cars or breed = bikes or breed = buses] [
    let relevant-light nobody

    if heading = 0 or heading = 180 [
      set relevant-light one-of lights in-cone 3 60 with [axis = "vertical"]
    ]
    if heading = 90 or heading = 270 [
      set relevant-light one-of lights in-cone 3 60 with [axis = "horizontal"]
    ]

    if relevant-light != nobody [
      let light-state [state] of relevant-light
      let dist-to-light distance relevant-light

     if member? light-state ["red" "yellow"] [
  ;; Vérifier si c'est un bus ou un véhicule avec personnalité
  ifelse breed = buses [
    set speed 0
    set waiting-time waiting-time + 1
  ] [
    ifelse driver-personality = "aggressive" and light-state = "yellow" and dist-to-light < 1 [
      set speed max-speed * 0.8
    ] [
      set speed 0
      set waiting-time waiting-time + 1
    ]
  ]
]

      if light-state = "green" [
        set speed max-speed
        set waiting-time 0
      ]
    ]
  ]
end

to traffic-jam-intelligent
  ask turtles with [breed = cars or breed = bikes] [
    let vehicles-ahead other turtles with [
      breed = cars or breed = bikes or breed = buses
    ] in-cone 3 90

    ifelse any? vehicles-ahead [
      let closest-distance min [distance myself] of vehicles-ahead

      let reaction-distance 1.5
      if driver-personality = "aggressive" [ set reaction-distance 1.0 ]
      if driver-personality = "cautious"   [ set reaction-distance 2.5 ]

      if closest-distance < reaction-distance [
        set speed speed * 0.2
      ]
      if closest-distance >= reaction-distance and closest-distance < (reaction-distance + 1) [
        set speed speed * 0.6
      ]
    ] [
      ;; ✅ CORRECTION : voie libre → remettre la vitesse normale
      if speed < max-speed [
        set speed max-speed
      ]
    ]
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; UTILITAIRES ROUTE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Vérifie si la case devant à une distance donnée est une route
to-report can-move-forward? [dist]
  let next-p patch-ahead dist
  report (next-p != nobody and [road?] of next-p)
end

;; Trouve une direction valide (parmi 0 90 180 270) qui mène à une route
to-report find-road-direction
  let valid-headings []
  foreach [0 90 180 270] [ h ->
    let test-patch patch-at-heading-and-distance h 1
    if test-patch != nobody and [road?] of test-patch [
      set valid-headings lput h valid-headings
    ]
  ]
  ifelse length valid-headings > 0 [
    report one-of valid-headings
  ] [
    report heading  ;; garder le cap si vraiment bloqué
  ]
end

;; Choisit la meilleure direction vers la destination EN RESTANT sur la route
to-report road-heading-towards-dest [dest]
  let valid-headings []
  foreach [0 90 180 270] [ h ->
    let test-patch patch-at-heading-and-distance h 1
    if test-patch != nobody and [road?] of test-patch [
      set valid-headings lput h valid-headings
    ]
  ]

  ;; Si aucune direction valide, garder le cap actuel
  if length valid-headings = 0 [ report heading ]

  ;; Parmi les directions valides, choisir la plus proche de la destination
  let target-h towards dest
  let best-h first valid-headings
  let best-diff 360

  foreach valid-headings [ h ->
    let d abs (subtract-headings target-h h)
    if d < best-diff [
      set best-h h
      set best-diff d
    ]
  ]
  report best-h
end
to move-vehicles-advanced
  ask turtles with [breed = cars or breed = bikes] [

    ;; débloquer les véhicules verbalisés
    if waiting-time < 0 [
      set waiting-time waiting-time + 1
      if waiting-time = 0 [
        set speed max-speed
        set color blue  ;; couleur normale
      ]
      stop  ;; ne pas bouger pendant la pénalité
    ]

    ;; ══ SÉCURITÉ : si hors route, revenir sur la route ══
    if not [road?] of patch-here [
      let nearest-road min-one-of patches with [
        road? and not intersection?
      ] in-radius 5 [distance myself]

      ifelse nearest-road != nobody [
        move-to nearest-road
        set heading find-road-direction
      ] [
        ;; Vraiment perdu : se téléporter sur une route quelconque
        move-to one-of patches with [road? and not intersection?]
        set heading find-road-direction
      ]
    ]

    ;; ══ VITESSE selon météo ══
    let zone [speed-zone] of patch-here
    let weather-factor 1.0
    if weather-condition = "rain"  [ set weather-factor 0.7 ]
    if weather-condition = "snow"  [ set weather-factor 0.5 ]
    let actual-speed speed * weather-factor

    ;; ══ Détection d'excès de vitesse ══
    if speed > zone and speed > 0 [
      set violated? true
      set violations violations + 1
      set color red
    ]

    ;; ══ MOUVEMENT PRINCIPAL ══
    if actual-speed > 0 [

      ;; Vérifier la route devant AVANT de bouger
      ifelse can-move-forward? actual-speed [

        ;; ✅ Route libre : avancer normalement
        fd actual-speed
        set total-distance          total-distance + actual-speed
        set total-distance-traveled total-distance-traveled + actual-speed
        set travel-time travel-time + 1
        ask patch-here [ set traffic-density traffic-density + 1 ]

      ] [
        ;; ❌ Obstacle ou hors route devant : chercher une direction valide
        let new-dir find-road-direction
        set heading new-dir

        ;; Réessayer d'avancer dans la nouvelle direction
        if can-move-forward? actual-speed [
          fd actual-speed
          set total-distance          total-distance + actual-speed
          set total-distance-traveled total-distance-traveled + actual-speed
          set travel-time travel-time + 1
          ask patch-here [ set traffic-density traffic-density + 1 ]
        ]
      ]

      ;; ══ Navigation aux intersections ══
      if [intersection?] of patch-here [
        ifelse has-gps? and destination != nobody and distance destination > 2 [
          ;; Avec GPS : meilleure direction vers destination (sur route)
          set heading road-heading-towards-dest destination
        ] [
          ;; Sans GPS : tourner aléatoirement, mais SEULEMENT vers une route
          let turn-choice random 100
          if turn-choice >= 60 [
            set heading find-road-direction
          ]
        ]
      ]
    ]
  ]
end
to unstuck-vehicles
  ask turtles with [breed = cars or breed = bikes] [
    if speed = 0 and waiting-time = 0 [
      if random 100 < 20 [
        ;; ✅ Vérifier la route avant d'avancer
        ifelse can-move-forward? 0.5 [
          fd 0.5
        ] [
          ;; Chercher une direction valide et essayer
          set heading find-road-direction
          if can-move-forward? 0.5 [ fd 0.5 ]
        ]
      ]
    ]
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BUS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to move-buses
  ask buses [
    if next-stop != nobody and length route > 0 [

      ;; Sécurité hors route
      if not [road?] of patch-here [
        let nearest-road min-one-of patches with [road? and intersection?] in-radius 5 [distance myself]
        if nearest-road != nobody [
          move-to nearest-road
          set heading bus-best-direction next-stop
        ]
      ]

      ;; Limite de vitesse + météo
      let zone-limit [speed-zone] of patch-here
      let weather-factor 1.0
      if weather-condition = "rain" [ set weather-factor 0.7 ]
      if weather-condition = "snow" [ set weather-factor 0.5 ]
      let safe-speed min (list max-speed zone-limit) * weather-factor

      ;; ✅ CORRECTION : seuil de détection agrandi (était 1.5)
      ifelse distance next-stop < 2.5 [

        ;; Arrivée à l'arrêt
        move-to patch-here
        set speed 0
        set waiting-time waiting-time + 1
        set color orange

        if waiting-time > 20 [
          let new-passengers [waiting-passengers] of next-stop
          set passengers passengers + new-passengers
          ask next-stop [ set waiting-passengers random 5 ] ;; ✅ recharge les passagers

          set current-stop (current-stop + 1) mod length route
          set next-stop item current-stop route
          set waiting-time 0
          set speed safe-speed
          set color yellow
          set heading bus-best-direction next-stop
        ]

      ] [
        set speed safe-speed
        set color yellow

        ;; Recalcul direction à chaque intersection
        if [intersection?] of patch-here [
          set heading bus-best-direction next-stop
        ]

        ;; ✅ CORRECTION : vérification patch-ahead avec nobody
        let next-patch patch-ahead safe-speed
        ifelse (next-patch != nobody and [road?] of next-patch) [
          fd safe-speed
        ] [
          set heading bus-best-direction next-stop
          let retry-patch patch-ahead safe-speed
          if (retry-patch != nobody and [road?] of retry-patch) [
            fd safe-speed
          ]
        ]
      ]
    ]
  ]
end
;; Trouve la meilleure direction (0/90/180/270)
;; parmi celles qui restent sur la route,
;; en se rapprochant le plus du prochain arrêt
to-report bus-best-direction [target-stop]

  let best-dir heading   ;; par défaut : garder le cap
  let best-dist 99999

  ;; Tester les 4 directions cardinales
  foreach [0 90 180 270] [ dir ->
    let next-p patch-at-heading-and-distance dir 1

    ;; La direction est valide seulement si le patch devant est une route
    if next-p != nobody and [road?] of next-p [

      ;; Calculer la distance depuis ce patch vers l'arrêt
      let dist-from-next [distance target-stop] of next-p

      if dist-from-next < best-dist [
        set best-dist dist-from-next
        set best-dir dir
      ]
    ]
  ]

  report best-dir
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DÉTECTION ACCIDENTS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to accidents-check-advanced
  ask turtles with [breed = cars or breed = bikes] [

    ;; Vérifier que l'agent est encore vivant avant d'agir
    if is-turtle? self [
      let nearby-vehicles other turtles with [
        breed = cars or breed = bikes
      ] in-radius 0.4

      ;; >= 1 : un seul voisin suffit pour une collision (correction du >= 2)
      if any? nearby-vehicles [
        set accidents accidents + 1

        ask patch-here [
          set accident-count accident-count + 1
          set pcolor red
        ]

        ;; Tuer les voisins seulement s'ils existent encore
        ask nearby-vehicles [
          if is-turtle? self [ die ]
        ]

        die
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POLICE INTELLIGENTE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to police-patrol-intelligent
  ask police-officers [
    ifelse patrol-mode? [
      let offender min-one-of turtles with [
        (breed = cars or breed = bikes) and violated?
      ] in-radius 8 [distance myself]

      if offender != nobody [
        set target offender
        set patrol-mode? false
      ]

      let hotspot max-one-of patches with [road? and accident-count > 0] in-radius 10 [accident-count]
      ifelse hotspot != nobody [
        set heading road-heading-towards-dest hotspot
        if can-move-forward? 1.2 [ fd 1.2 ]
      ] [
        if random 100 < 15 [ set heading find-road-direction ]
        if can-move-forward? 1.0 [ fd 1.0 ]
      ]
      ] [
      ifelse target != nobody [
        ifelse is-turtle? target and member? target turtles with [breed = cars or breed = bikes] [
          face target
          fd 2.5

         if distance target < 1.5 [
            ask target [
               set speed 0
               set color yellow
               set violated? false
               ;;  CORRECTION : reprendre après 30 ticks via waiting-time
               set waiting-time -30  ;; compteur négatif → reprend quand il atteint 0
         ]
         set tickets-issued tickets-issued + 1
         set tickets-given tickets-given + 1
         set efficiency-score efficiency-score + 1
         set target nobody
         set patrol-mode? true
]
        ] [
          set target nobody
          set patrol-mode? true
        ]
      ] [
        set target nobody
        set patrol-mode? true
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PIÉTONS INTELLIGENTS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to move-pedestrians-smart
  ask pedestrians [
    ifelse destination != nobody and distance destination > 1 [
      let cross one-of patches with [crosswalk?] in-radius 6

      ifelse cross != nobody [
        face cross
        set waiting-at-crosswalk? true

        let safe-to-cross? false
        ask cross [
          if any? lights-here with [state = "red"] [
            set safe-to-cross? true
          ]
        ]

        ifelse safe-to-cross? or patience <= 0 [
          fd 0.5
          set patience 50 + random 50
        ] [
          set patience patience - 1
        ]
      ] [
        face destination
        fd 0.3
        set waiting-at-crosswalk? false
      ]

      if distance destination < 1 [
        set destination one-of patches with [not road? and distance myself > 10]
      ]
    ] [
      if random 100 < 20 [ rt random 360 ]
      fd 0.3
    ]

    if [road?] of patch-here and not [crosswalk?] of patch-here [
      let safe-spot min-one-of patches with [not road?] in-radius 3 [distance myself]
      if safe-spot != nobody [ move-to safe-spot ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ENVIRONNEMENT DYNAMIQUE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-environment
  if ticks mod 60 = 0 [
    set current-hour (current-hour + 1) mod 24
  ]

  set rush-hour? (current-hour >= 7 and current-hour <= 9) or (current-hour >= 17 and current-hour <= 19)

  if random 1000 < 5 [
    set weather-condition one-of ["clear" "rain" "snow"]
  ]

  if rush-hour? and count cars < (number-of-cars * 1.5) [
    if random 100 < 30 [
      create-cars 1 [
        set shape "car"
        set driver-personality "normal"
        set color blue
        move-to one-of patches with [road? and not intersection?]
        set max-speed 1.2 + random-float 0.3
        set speed max-speed
        set violated? false
        set waiting-time 0
        set travel-time 0
        set has-gps? (random 100 < gps-adoption-rate)
        set total-distance-traveled 0
        set fuel-efficiency 0.8 + random-float 0.4  ;; ← AJOUTER cette ligne
        set destination one-of patches with [road? and distance myself > 20]
        choose-lane-direction
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MÉTRIQUES ET STATISTIQUES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-statistics-advanced
  let waiting-vehicles turtles with [
    (breed = cars or breed = bikes) and waiting-time > 0
  ]

  ifelse any? waiting-vehicles [
    set average-waiting-time mean [waiting-time] of waiting-vehicles
  ] [
    set average-waiting-time 0
  ]

  let moving-vehicles turtles with [
    (breed = cars or breed = bikes) and speed > 0
  ]

  ifelse any? moving-vehicles [
    set average-speed mean [speed] of moving-vehicles
  ] [
    set average-speed 0
  ]

  let total-vehicles count cars + count bikes
  let max-capacity 100
  set congestion-level (total-vehicles / max-capacity) * 100

  ifelse average-speed > 0 [
    set traffic-flow (average-speed / 2) * 100
  ] [
    set traffic-flow 0
  ]

  if ticks mod 100 = 0 [
    ask patches with [road?] [
      set traffic-density traffic-density * 0.9
      set congestion-score traffic-density

      if show-heatmap? [
        if traffic-density > 50 [ set pcolor red ]
        if traffic-density > 30 and traffic-density <= 50 [ set pcolor orange ]
        if traffic-density > 10 and traffic-density <= 30 [ set pcolor yellow ]
        if traffic-density <= 10 [ set pcolor gray - 1 ]
      ]
    ]
  ]

  ask patches with [accident-count > 0 and ticks mod 200 = 0] [
    set pcolor gray - 1
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VISUALISATIONS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to toggle-heatmap
  set show-heatmap? not show-heatmap?

  ifelse show-heatmap? [
    ask patches with [road?] [
      if traffic-density > 50 [ set pcolor red ]
      if traffic-density > 30 and traffic-density <= 50 [ set pcolor orange ]
      if traffic-density > 10 and traffic-density <= 30 [ set pcolor yellow ]
      if traffic-density <= 10 [ set pcolor gray - 1 ]
    ]
  ] [
    setup-roads
  ]
end

to highlight-accident-hotspots
  ask patches with [accident-count > 2] [
    set pcolor red + 2
  ]
end
to debug-bikes
  ask bikes [
    print (word "Bike " who ": heading=" heading " speed=" speed " position=" xcor "," ycor)
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; RÉGÉNÉRATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to regenerate-vehicles
  if ticks mod 150 = 0 [
    if count cars < number-of-cars [
      create-cars 1 [
        set shape "car"
        set driver-personality one-of ["aggressive" "normal" "normal" "cautious"]
        if driver-personality = "aggressive" [ set color red ]
        if driver-personality = "normal" [ set color blue ]
        if driver-personality = "cautious" [ set color green ]
        move-to one-of patches with [road? and not intersection?]
        if driver-personality = "aggressive" [ set max-speed 1.8 + random-float 0.4 ]
        if driver-personality = "normal" [ set max-speed 1.2 + random-float 0.3 ]
        if driver-personality = "cautious" [ set max-speed 0.8 + random-float 0.2 ]
        set speed max-speed
        set violated? false
        set waiting-time 0
        set travel-time 0
        set has-gps? (random 100 < gps-adoption-rate)
        set total-distance-traveled 0
        set destination one-of patches with [road? and distance myself > 20]
        choose-lane-direction
      ]
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BOUCLE PRINCIPALE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  update-environment
  update-lights-intelligent
  navigate-to-destination
  obey-lights-smart
  traffic-jam-intelligent
  move-vehicles-advanced
  unstuck-vehicles
  accidents-check-advanced
  move-buses
  police-patrol-intelligent
  move-pedestrians-smart
  update-statistics-advanced
  regenerate-vehicles

  tick
end]]></code>
